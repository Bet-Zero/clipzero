{
  "name": "clipzero",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "start:web": "npm run start -w apps/web",
    "start:api": "npm run start -w apps/api",
    "doctor": "node tools/runtime/doctor.mjs",
    "verify:prod": "node tools/runtime/verify-prod.mjs",
    "verify:token:set": "node tools/runtime/set-verify-token.mjs",
    "verify:token:clear": "node tools/runtime/clear-verify-token.mjs",
    "verify:token:status": "node tools/runtime/check-verify-token.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "lint:web": "npm run lint -w apps/web",
    "test:api": "npm run test -w apps/api",
    "test:web": "npm run test -w apps/web",
    "test": "npm run test:api && npm run test:web",
    "test:e2e": "npm run test:e2e -w apps/web"
  }
}
